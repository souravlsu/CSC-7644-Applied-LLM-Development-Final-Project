# ----- LLM (generation) -----
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# ----- Embeddings -----
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=64

# ----- Retrieval -----
TOP_K=6
USE_HYBRID=true
CHUNK_TOKENS=200
CHUNK_OVERLAP=80
